# Public deployments must use the production Compose override so the container
# is reachable only through the HTTPS reverse proxy on the host.
DINOTTY_TOKEN=replace-with-a-long-random-token
RUST_LOG=info
TZ=Asia/Shanghai
WORKSPACE_DIR=/opt/dinotty/workspace
# Existing external Docker network used by the Caddy reverse proxy.
DINOTTY_CADDY_NETWORK=myownerim_public
